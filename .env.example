# Copy this file to .env in the repository root and fill in tokens as needed.
# Keep actual tokens in .env, which is ignored by Git.
# Saved-result views and analyses work with both values left empty.

# Required for full-dataset collection; optional for higher GitHub API limits
# when assessing public repositories through the web app.
GITHUB_TOKEN=

# Required only for new Qwen assessments through the university KISTE service.
# Restart the web app after configuring this token.
KISTE_API_TOKEN=
